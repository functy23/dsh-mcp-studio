{
  "name": "dsh-mcp-studio",
  "version": "0.1.0",
  "description": "MCP Studio for DeepSeek Harness — cross-platform (Web / Desktop) MCP server & Skills manager in a single plugin: settings pages + HTTP API + model tools, zero Tauri dependency.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./lib/client.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.1 <0.2.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "check": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs && node scripts/test.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "mcp",
    "mcp-server",
    "skills",
    "cordis"
  ],
  "license": "MIT",
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "author": {
    "name": "functy23",
    "url": "https://github.com/functy23"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/functy23/dsh-mcp-studio.git"
  },
  "homepage": "https://github.com/functy23/dsh-mcp-studio#readme",
  "bugs": {
    "url": "https://github.com/functy23/dsh-mcp-studio/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
